{
  "name": "start-deck",
  "version": "1.2.9",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "VITE_BACKEND=http://127.0.0.1:9001 vite --host 127.0.0.1 --port 9003",
    "server": "cd .. && PORT=9001 META_SERVER_BASE_URL=http://127.0.0.1:9002 cargo run --bin startdeck-server",
    "meta-server": "cd .. && META_SERVER_PORT=9002 cargo run --bin startdeck-metaserver",
    "server:hot": "cd .. && PORT=9001 META_SERVER_BASE_URL=http://127.0.0.1:9002 cargo run --bin startdeck-server",
    "wait-backend": "node -e \"const base=process.env.VITE_BACKEND||'http://127.0.0.1:9001';const target=new URL('/api/system-config',base).toString();const timeoutMs=60000;const intervalMs=500;const start=Date.now();const attempt=async()=>{try{const ctrl=new AbortController();const t=setTimeout(()=>ctrl.abort(),1500);const res=await fetch(target,{signal:ctrl.signal});clearTimeout(t);if(res.ok){process.exit(0);}}catch(e){}if(Date.now()-start>timeoutMs){console.error('Backend health check timed out:',target);process.exit(1);}setTimeout(attempt,intervalMs);};attempt();\"",
    "client": "run-s wait-backend dev",
    "start": "run-p meta-server server client",
    "start:hot": "run-p meta-server server:hot client",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --host 127.0.0.1 --port 9003",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest --environment=jsdom",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@types/pako": "^2.0.4",
    "@vueuse/core": "^14.1.0",
    "dompurify": "^3.3.1",
    "gridstack": "^12.6.0",
    "pako": "^2.1.0",
    "pinia": "^3.0.4",
    "tyme4ts": "^1.5.0",
    "vue": "^3.5.25",
    "vue-cropper": "^1.1.4",
    "vue-draggable-plus": "^0.6.0"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^2.1.3",
    "vue-tsc": "^3.1.5"
  }
}
